NODE_ENV=development
PORT=3000

CORS_ORIGIN=http://localhost:4200

# so em producao: proxies entre a internet e a API (padrao 1; com o proxy da Cloudflare = 2)
# TRUST_PROXY=1
# atras da Cloudflare (tunel ou nuvem laranja): o IP real vem desse cabecalho
# CLIENT_IP_HEADER=cf-connecting-ip

# branch dev do Neon; a producao (main) so existe no api.env da VM
DATABASE_URL=your_database_url
# os e2e criam usuarios: so rodam com este definido (branch do Neon so para teste)
E2E_DATABASE_URL=your_test_database_url

JWT_SECRET=your_jwt_secret

TMDB_API_KEY=your-tmdb-api-key

# Mailpit no desenvolvimento (mailpit.exe; caixa em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prisma <nao-responda@prisma.local>"
