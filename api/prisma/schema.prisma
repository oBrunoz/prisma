generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// de onde vem a capa do perfil: o primeiro favorito, uma cena escolhida ou nada
enum CoverKind {
  FAVORITE
  TITLE
  NONE
}

enum MediaType {
  MOVIE
  TV
}

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  username        String    @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  bio             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // ate quando a pessoa ja foi avisada dos seguidores novos
  followersSeenAt DateTime?
  coverKind       CoverKind @default(FAVORITE)
  coverMediaId    String?
  // caminho da imagem na TMDB, conferido contra as cenas do titulo
  coverPath       String?

  watchlist     WatchlistItem[]
  favorites     Favorite[]
  coverMedia    Media?          @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  avatar        Avatar?
  reviews       Review[]
  following     Follow[]        @relation("UserFollowing")
  followers     Follow[]        @relation("UserFollowers")
  refreshTokens RefreshToken[]
  emailChange   EmailChange?

  @@map("users")
}

model Media {
  id          String    @id @default(uuid(7))
  tmdbId      Int
  type        MediaType
  title       String
  posterPath  String?
  releaseDate DateTime?
  syncedAt    DateTime  @updatedAt

  watchlistItems WatchlistItem[]
  reviews        Review[]
  favorites      Favorite[]
  coverOf        User[]          @relation("UserCover")

  @@unique([tmdbId, type])
  @@map("medias")
}

model WatchlistItem {
  id      String   @id @default(uuid(7))
  userId  String
  mediaId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, addedAt])
  @@map("watchlist_items")
}

model Review {
  id        String    @id @default(uuid(7))
  userId    String
  mediaId   String
  rating    Int?
  content   String?
  liked     Boolean   @default(false)
  watchedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId, createdAt])
  @@map("reviews")
}

// ate quatro titulos que a pessoa escolhe para o perfil, na ordem dela
model Favorite {
  userId   String
  mediaId  String
  position Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, position])
  @@unique([userId, mediaId])
  @@map("favorites")
}

// a foto enviada, ja regravada pelo servidor (webp quadrado, sem metadados)
model Avatar {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// pedido de troca de e-mail: o endereco so muda quando o codigo enviado a ele volta
model EmailChange {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  newEmail  String
  codeHash  String
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_changes")
}
